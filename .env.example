# LLM settings for Pilot 2. There is no YAML for these calls.
# Copy to `.env` and fill in values. Secrets are never committed.
# The loader also reads `../dg-query-disambiguation/.env` when present.
#
# LLM_PROVIDER chooses the chat endpoint: scayle | ollama | openai | gemini

LLM_PROVIDER=scayle

# Scayle
SCAYLE_USERNAME=
SCAYLE_PASSWORD=
SCAYLE_BASE_URL=https://chat.scayle.es/api
SCAYLE_MODEL_NAME=qwen3
SCAYLE_VERIFY_SSL=true

# Local Ollama (OpenAI-compatible). Uncomment LLM_PROVIDER to use it.
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3:8b

# OpenAI, or any OpenAI-compatible base URL.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL_NAME=gpt-4o-mini

# Gemini
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL_NAME=gemini-3.6-flash

# Query disambiguation (language endpoint)
QUERY_DISAMBIGUATION_URL=https://datagems-dev.scayle.es/query-disambiguation
# QUERY_DISAMBIGUATION_TOKEN=

# ── Cross-Dataset Discovery (retrieval) ──
# Base URL for the search API.
CROSS_DATASET_DISCOVERY_URL=https://datagems-dev.scayle.es/cross-dataset-discovery
# Comma-separated dataset UUIDs to restrict searches (empty = all).
# Available language corpora (from cross-dataset-discovery/scripts/unify_datasets.py):
#   EncycNet           07382b91-5bc5-42f9-8391-33adc2460c19
#   19th C. Knowledge  d84d1a2e-127d-4393-91d0-afb7e4fd9c68  (Britannica / KP)
#   Diderot            d5c34990-9acf-4349-91d4-924f58565922
#   Wikipedia          1f6fba0c-9aea-4345-b5a3-457c924f9e0c
# Restrict search and corpus-analysis to the language corpora.
# EncycNet, KP/Britannica, Diderot, Wikipedia.
CROSS_DATASET_IDS=07382b91-5bc5-42f9-8391-33adc2460c19,d84d1a2e-127d-4393-91d0-afb7e4fd9c68,d5c34990-9acf-4349-91d4-924f58565922,1f6fba0c-9aea-4345-b5a3-457c924f9e0c
# Search mode: sparse (BM25), dense (semantic), or hybrid (RRF).
CROSS_DATASET_SEARCH_MODE=hybrid

# Auth: Keycloak OIDC (datagems-dev.scayle.es/oauth/realms/dev).
# Working password-grant (same as corpus-analysis-search curl):
#   client_id=swagger-client
#   scope=openid datagems offline_access
DG_USERNAME=dg-user-1
DG_PASSWORD=dg-user-1
OIDC_CLIENT_ID=swagger-client
OIDC_SCOPE=openid datagems offline_access
OIDC_TOKEN_URL=https://datagems-dev.scayle.es/oauth/realms/dev/protocol/openid-connect/token
OIDC_ISSUER_URL=https://datagems-dev.scayle.es/oauth/realms/dev
OIDC_AUDIENCE=swagger-client
# Local runs: skip JWT checks. The cluster sets AUTH_DISABLED=false.
AUTH_DISABLED=true
# Or set a pre-acquired JWT token directly:
# CROSS_DATASET_DISCOVERY_TOKEN=
