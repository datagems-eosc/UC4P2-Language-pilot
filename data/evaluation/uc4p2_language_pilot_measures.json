    {
      "id": "uc4p2.token_f1",
      "family": "data",
      "label": "Token F1",
      "description": "Harmonic mean of token precision and token recall.",
      "definition": {
        "key": "uc4p2.token_f1",
        "version": "1.0",
        "status": "defined",
        "formula": "2 * P * R / (P + R)"
