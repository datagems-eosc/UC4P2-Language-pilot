  "measures": [
    {
      "id": "uc4p2.exact_match",
      "family": "data",
      "label": "Exact match",
      "description": "Binary equality of the synthesized answer and ground truth after stripping [ref_N] citation marks, lowercasing, and dropping punctuation.",
      "definition": {
        "key": "uc4p2.exact_match",
        "version": "1.0",
        "status": "defined",
        "formula": "1 if normalize(strip_citations(hyp)) == normalize(ref) else 0"
      },
      "valueType": "number",
      "unit": {
        "code": "ratio",
        "symbol": null,
        "status": "declared"
      },
      "scale": {
        "min": 0,
        "max": 1
      },
      "objective": "maximize",
      "aggregation": {
        "default": "mean",
        "allowed": [
          "none",
          "mean"
        ]
      },
      "dimensions": [
        {
          "id": "query_id",
          "label": "Question / Subquestion ID",
          "type": "nominal",
          "role": "category",
          "required": true
        },
        {
          "id": "operator",
          "label": "Pipeline operator",
          "type": "nominal",
          "role": "group",
          "required": true
        },
        {
          "id": "gold_source",
          "label": "Gold source",
          "type": "nominal",
          "role": "group",
          "required": false
        },
        {
          "id": "llm_model",
          "label": "Pipeline LLM",
          "type": "nominal",
          "role": "group",
          "required": false
        }
      ],
      "observations": [],
      "visualization": {
        "preferred": "bar",
        "x": "query_id",
        "y": "value"
      },
      "provenance": {
        "sourceFile": "src/evaluation/nlg.py",
        "sourceMeasure": "exact_match"
      }
    },
    {
      "id": "uc4p2.token_precision",
      "family": "data",
      "label": "Token precision",
      "description": "Bag-of-tokens precision of hypothesis unigrams against the reference.",
