{
  "schemaVersion": "1.0",
  "evaluation": {
    "id": "uc4p2-language-pilot",
    "projectId": "uc4p2_language_pilot",
    "label": "UC4P2 Language Pilot",
    "provenance": {
      "sourceFile": "src/evaluation/nlg.py",
      "note": "Measures mirror data/evaluation/StudentQuiz.json (schemaVersion 1.0). Each observation may include calculation.elements with the inputs used to produce the value for that run."
    }
