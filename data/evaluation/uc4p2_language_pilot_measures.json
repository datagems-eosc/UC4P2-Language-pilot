    {
      "id": "uc4p2.bleu",
      "family": "data",
      "label": "BLEU",
      "description": "Sentence BLEU with uniform weights over 1\u20134 gram clipped precision and a brevity penalty.",
      "definition": {
        "key": "uc4p2.bleu",
        "version": "1.0",
        "status": "defined",
        "formula": "BP * exp(mean(log p_n)) for n=1..4; BP = exp(1 - |ref|/|hyp|) if |hyp| < |ref| else 1"
      },
      "valueType": "number",
      "unit": {
        "code": "ratio",
        "symbol": null,
        "status": "declared"
      },
      "scale": {
